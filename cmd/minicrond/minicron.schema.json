{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minicron.dev/schema/v0.1/config.json",
  "title": "minicron configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bind": {
          "type": "string",
          "default": "127.0.0.1:7423"
        },
        "unix_socket": {
          "type": "boolean",
          "default": true
        },
        "allow_insecure_remote": {
          "type": "boolean",
          "default": false,
          "description": "Explicitly allow plaintext HTTP on a non-loopback bind address"
        }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "type": "string",
          "default": "UTC"
        },
        "max_concurrent_runs": {
          "type": "integer",
          "minimum": 1,
          "default": 32
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keep_runs_default": {
          "type": "integer",
          "minimum": 1,
          "default": 200
        },
        "keep_for_default": {
          "type": "integer",
          "minimum": 1,
          "default": 30,
          "description": "Default run age retention in days"
        },
        "audit_keep": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "const": "file"
        },
        "max_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384,
          "default": 256,
          "description": "Maximum single log line size in KiB"
        },
        "worker_flush_interval": {
          "type": "integer",
          "minimum": 1,
          "default": 15,
          "description": "Worker log flush interval in minutes"
        },
        "db_keep_for": {
          "type": "integer",
          "minimum": 1,
          "default": 30,
          "description": "Log archive retention in days"
        },
        "db_prune_at": {
          "type": "string",
          "default": "03:30"
        }
      }
    },
    "defaults": {
      "$ref": "#/$defs/job_defaults"
    },
    "alert_channel": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/alert_channel"
      }
    }
  },
  "$defs": {
    "job_defaults": {
      "type": "object",
      "additionalProperties": false,
      "description": "Defaults applied to jobs when saved or imported; bundle defaults and explicit job values take precedence",
      "properties": {
        "enabled": {"type": "boolean"},
        "shell": {"type": "string"},
        "timezone": {"type": "string"},
        "catch_up": {"enum": ["none", "latest"]},
        "on_overlap": {"enum": ["skip", "parallel"]},
        "retries": {"type": "integer", "minimum": 0, "maximum": 1000},
        "retry_delay": {"type": "integer", "minimum": 1, "maximum": 86400},
        "run_as": {"type": "string"},
        "working_dir": {"type": "string"},
        "env_base": {"enum": ["clean", "inherit"]},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "secret_env": {"type": "object", "additionalProperties": {"type": "string"}},
        "env_file": {"type": "string"},
        "timeout": {"type": "integer", "minimum": 0},
        "grace": {"type": "integer", "minimum": 1},
        "stop_signal": {"type": "string"},
        "success_codes": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 255}},
        "keep_runs": {"type": "integer", "minimum": 0},
        "keep_for": {"type": "integer", "minimum": 0},
        "log_max": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "log_on_full": {"enum": ["drop_old", "drop_new"]},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "alerts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "alert_channel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,99}$"
        },
        "type": {
          "const": "telegram"
        },
        "bot_token": {
          "type": "string",
          "pattern": "^(env:[^:]+|file:/)"
        },
        "chat_id": {
          "type": "string",
          "minLength": 1
        },
        "disable_notification": {
          "type": "boolean",
          "default": false
        },
        "batch_window": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "default": 10,
          "description": "Batch window from first alert in seconds"
        }
      },
      "required": [
        "name",
        "type",
        "bot_token",
        "chat_id"
      ]
    }
  }
}
