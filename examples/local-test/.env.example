# minicron local-testing environment.
# start.sh copies this file to .env on first run; edit .env to change behavior.
# Relative paths are resolved against this examples/local-test directory.

# Bootstrap TOML passed to `minicron daemon --config` (checked in, see minicron.toml).
MINICRON_CONFIG=minicron.toml

# Sandbox data dir: SQLite DB, tagged logs, unix socket, daemon.log.
# Everything minicron writes lives here. Delete it to reset the sandbox.
MINICRON_DATA=.data

# Optional: use an existing binary instead of building from source with go.
#MINICRON_BIN=/usr/local/bin/minicron

# Optional: make CLI commands (list/run/logs/...) use HTTP + bearer token
# instead of the local unix socket. Leave unset for socket mode (no token
# needed). If you enable this, set MINICRON_TOKEN to a token printed by
# start.sh (it is shown once, on first boot, or after `mc token --rotate`).
#MINICRON_URL=http://127.0.0.1:7423
#MINICRON_TOKEN=
