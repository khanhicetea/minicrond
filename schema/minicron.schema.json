{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minicron.dev/schema/v0.1/config.json",
  "title": "minicron configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bind": {
          "type": "string",
          "default": "127.0.0.1:7423"
        },
        "unix_socket": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "include": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prune_missing": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "type": "string",
          "default": "UTC"
        },
        "max_concurrent_runs": {
          "type": "integer",
          "minimum": 1,
          "default": 32
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keep_runs_default": {
          "type": "integer",
          "minimum": 1,
          "default": 200
        },
        "keep_for_default": {
          "type": "string"
        },
        "audit_keep": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "const": "file"
        },
        "max_line": {
          "type": "string"
        },
        "worker_flush_interval": {
          "type": "string",
          "default": "15m"
        },
        "db_keep_for": {
          "type": "string",
          "default": "720h"
        },
        "db_prune_at": {
          "type": "string",
          "default": "03:30"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "shell": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "catch_up": {
          "enum": [
            "none",
            "latest"
          ]
        },
        "on_overlap": {
          "enum": [
            "skip",
            "parallel"
          ]
        },
        "run_as": {
          "type": "string"
        },
        "working_dir": {
          "type": "string"
        },
        "env_base": {
          "enum": [
            "clean",
            "inherit"
          ]
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "secret_env": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(env:|file:/)"
          }
        },
        "env_file": {
          "type": "string"
        },
        "timeout": {
          "type": "string"
        },
        "grace": {
          "type": "string"
        },
        "stop_signal": {
          "type": "string"
        },
        "success_codes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "keep_runs": {
          "type": "integer",
          "minimum": 1
        },
        "keep_for": {
          "type": "string"
        },
        "log_max": {
          "type": "string"
        },
        "log_on_full": {
          "enum": [
            "drop_old",
            "drop_new",
            "kill"
          ]
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "restart": {
          "enum": [
            "always",
            "on-failure",
            "never"
          ]
        },
        "restart_delay": {
          "type": "string"
        },
        "max_restart_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "healthy_after": {
          "type": "string"
        }
      }
    },
    "job": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/definition"
      }
    },
    "worker": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/definition"
      }
    }
  },
  "$defs": {
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,99}$"
        },
        "command": {
          "type": "string"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "shell": {
          "type": "string"
        },
        "schedule": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "catch_up": {
          "enum": [
            "none",
            "latest"
          ]
        },
        "on_overlap": {
          "enum": [
            "skip",
            "parallel"
          ]
        },
        "run_on_start": {
          "type": "boolean"
        },
        "run_as": {
          "type": "string"
        },
        "working_dir": {
          "type": "string"
        },
        "env_base": {
          "enum": [
            "clean",
            "inherit"
          ]
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "secret_env": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(env:|file:/)"
          }
        },
        "env_file": {
          "type": "string"
        },
        "timeout": {
          "type": "string"
        },
        "grace": {
          "type": "string"
        },
        "stop_signal": {
          "type": "string"
        },
        "success_codes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "keep_runs": {
          "type": "integer",
          "minimum": 1
        },
        "keep_for": {
          "type": "string"
        },
        "log_max": {
          "type": "string"
        },
        "log_on_full": {
          "enum": [
            "drop_old",
            "drop_new",
            "kill"
          ]
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "autostart": {
          "type": "boolean"
        },
        "restart": {
          "enum": [
            "always",
            "on-failure",
            "never"
          ]
        },
        "restart_delay": {
          "type": "string"
        },
        "max_restart_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "healthy_after": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        }
      },
      "required": [
        "name"
      ]
    }
  }
}
